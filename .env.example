# AI Workflow Automation Platform — environment template
# Copy to .env and adjust. No secrets are needed: providers are scripted.
AWAP_DEFAULT_MAX_TOKENS=20000
AWAP_DEFAULT_MAX_COST_USD=2.00
AWAP_DEFAULT_MAX_LATENCY_MS=120000
AWAP_DEFAULT_MAX_STEPS=100
AWAP_LLM_INPUT_COST_PER_1K=0.002
AWAP_LLM_OUTPUT_COST_PER_1K=0.006
AWAP_STORE_PATH=data/store.json
AWAP_AUDIT_PATH=data/audit.jsonl
AWAP_APPROVAL_EXPIRY_S=3600
AWAP_APPROVAL_ON_EXPIRY=escalate
AWAP_MAX_LOOP_ITERATIONS=50
